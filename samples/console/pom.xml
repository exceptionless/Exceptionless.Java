<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.exceptionless</groupId>
        <artifactId>exceptionless-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>exceptionless-sample-console</artifactId>
    <name>Exceptionless Sample: Console</name>
    <description>A plain Java app that reports errors, logs, feature usage and sessions.</description>

    <properties>
        <automatic.module.name>com.example.console</automatic.module.name>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <sample.args></sample.args>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.exceptionless</groupId>
            <artifactId>exceptionless-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.exceptionless</groupId>
            <artifactId>exceptionless-jul</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- exec:exec runs the sample in its own JVM, like a real app: java.util.logging can load the
                 handler from the class path, and shutdown hooks and uncaught exceptions behave normally. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>com.example.console.ConsoleApp</argument>
                        <argument>${sample.args}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
